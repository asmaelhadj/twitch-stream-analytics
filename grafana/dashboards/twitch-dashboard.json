{
  "dashboard": {
    "id": null,
    "title": "Twitch Real-Time Analytics Dashboard",
    "tags": ["twitch", "streaming", "analytics"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Live Viewer Count",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": "elasticsearch",
            "query": "viewer_count:>0"
          }
        ]
      },
      {
        "id": 2,
        "title": "Top Games by Popularity",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Chat Sentiment Analysis",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Toxicity Detection",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "Stream Categories",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ]
  }
}